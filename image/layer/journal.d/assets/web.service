[Unit]
Description=Secure Journal
ConditionPathExists=/var/lib/secure-journal/auth.json
After=secure-journal-setup.service

[Service]
Type=simple
User=journal
Group=journal
Environment=PYTHONPATH=/opt/secure-journal
Environment=JOURNAL_DATA_DIR=/var/lib/secure-journal
Environment=JOURNAL_WEB_HOST=0.0.0.0
Environment=JOURNAL_WEB_PORT=443
ExecStart=/usr/bin/python3 -m journal_app.web
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
