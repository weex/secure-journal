#!/bin/sh
# crypttab keyscript for the journal's LUKS root.
#
# stdout is the passphrase and nothing else. cryptsetup reads it as the key
# and strips one trailing newline. Every message goes to stderr.
#
# The Pi boot ROM cannot show a UI. This runs later, inside the initramfs,
# after the kernel has started. unl0kr (Debian Trixie package 2.0.3+dfsg-2)
# draws a touch keyboard on the framebuffer. The packaged keyscript calls
# unl0kr with no fallback, so a dark panel would leave the disk locked with
# no other prompt. This wrapper waits briefly for a framebuffer, tries
# unl0kr, and otherwise asks on the text console (HDMI + USB keyboard).
#
# Add sj.unlock=console to cmdline.txt on the FAT boot partition to skip the
# on-screen UI. That file is readable without the passphrase.
#
# Test hooks (unset on a real boot):
#   SECURE_JOURNAL_UNL0KR    unl0kr binary
#   SECURE_JOURNAL_ASKPASS   console askpass helper
#   SECURE_JOURNAL_CMDLINE   file to read instead of /proc/cmdline
#   SECURE_JOURNAL_UNLOCK_NO_WAIT=1  do not wait for a framebuffer

set -u

if [ -z "${CRYPTTAB_SOURCE:-}" ] || [ -z "${CRYPTTAB_NAME:-}" ]; then
  echo "secure-journal: this keyscript is only run by cryptsetup" >&2
  exit 1
fi

UNL0KR=${SECURE_JOURNAL_UNL0KR:-/usr/bin/unl0kr}
ASKPASS=${SECURE_JOURNAL_ASKPASS:-/lib/cryptsetup/askpass}
CMDLINE=${SECURE_JOURNAL_CMDLINE:-/proc/cmdline}

console_unlock() {
  if [ -x "$ASKPASS" ]; then
    exec "$ASKPASS" "Disk passphrase: "
  fi
  printf 'Disk passphrase: ' >&2
  IFS= read -r pass || true
  printf '%s\n' "$pass"
}

want_console=0
if [ -r "$CMDLINE" ]; then
  cmdline_text=$(cat "$CMDLINE")
  # Tokens on the Pi cmdline are space-separated and do not contain spaces.
  # Globbing is off so a token cannot expand against files in the initramfs.
  set -f
  # shellcheck disable=SC2086
  for token in $cmdline_text; do
    if [ "$token" = "sj.unlock=console" ]; then
      want_console=1
    fi
  done
  set +f
fi

if [ "$want_console" -eq 1 ]; then
  echo "secure-journal: on-screen unlock skipped (sj.unlock=console)." >&2
  console_unlock
fi

if [ ! -x "$UNL0KR" ]; then
  echo "secure-journal: unl0kr is not in the initramfs. Use a USB keyboard." >&2
  console_unlock
fi

if [ "${SECURE_JOURNAL_UNLOCK_NO_WAIT:-}" != 1 ]; then
  # The Touch Display 2 overlay binds once these modules are loaded. The
  # names that this kernel does not build are skipped. SPI panels need
  # ili9486 and ads7846; the official panel needs the ILI9881 driver and
  # goodix. The firmware does not light Touch Display 2 by itself.
  for mod in vc4 panel-ilitek-ili9881c goodix ili9486 fb_ili9486 ads7846 spi-bcm2835; do
    modprobe "$mod" 2>/dev/null || true
  done
  i=0
  while [ "$i" -lt 20 ]; do
    if [ -e /dev/dri/card0 ] || [ -e /dev/fb0 ]; then
      break
    fi
    i=$((i + 1))
    sleep 1
  done
  if [ ! -e /dev/dri/card0 ] && [ ! -e /dev/fb0 ]; then
    echo "secure-journal: no display device after 20s. Use a USB keyboard." >&2
    console_unlock
  fi
  # The panel regulator and the backlight come up just after the DRM node.
  sleep 2
fi

plymouth hide-splash >/dev/null 2>&1 || true
ttymode=""
if command -v stty >/dev/null 2>&1; then
  ttymode=$(stty -g 2>/dev/null || true)
  stty -echo -icanon min 0 time 0 >/dev/null 2>&1 || true
fi

set +e
"$UNL0KR"
status=$?
set -e

if [ -n "$ttymode" ]; then
  stty "$ttymode" >/dev/null 2>&1 || true
fi

if [ "$status" -eq 0 ]; then
  exit 0
fi

echo "secure-journal: on-screen unlock failed. Use a USB keyboard." >&2
console_unlock
