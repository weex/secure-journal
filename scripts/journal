#!/bin/sh
# Open today's journal entry, creating it if this is the first time today.
# The directory is mode 0700. This is a text file on an encrypted root,
# not a second layer of encryption.

set -eu

umask 077

dir=${JOURNAL_DIR:-$HOME/journal}
year=$(date +%Y)
month=$(date +%m)
day=$(date +%F)
file="$dir/$year/$month/$day.md"

mkdir -p "$dir/$year/$month"
chmod 700 "$dir" "$dir/$year" "$dir/$year/$month"

if [ ! -e "$file" ]; then
  printf '# %s\n\n' "$day" > "$file"
  chmod 600 "$file"
fi

# The touchscreen app is the one the setup installs. Mousepad, then EDITOR,
# then nano, cover a session where that app is not installed yet.
if [ -n "${WAYLAND_DISPLAY:-${DISPLAY:-}}" ]; then
  ui_root=/opt/secure-journal
  if [ -f "$ui_root/ui/journal_app.py" ] && python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
    PYTHONPATH=$ui_root${PYTHONPATH:+:$PYTHONPATH}
    export PYTHONPATH
    exec python3 -m ui.journal_app
  fi
  if command -v mousepad >/dev/null 2>&1; then
    exec mousepad "$file"
  fi
  if command -v gnome-text-editor >/dev/null 2>&1; then
    exec gnome-text-editor "$file"
  fi
fi

if [ -n "${EDITOR:-}" ]; then
  # EDITOR is a single command name. Arguments belong in a wrapper script.
  exec "$EDITOR" "$file"
fi

if command -v nano >/dev/null 2>&1; then
  exec nano "$file"
fi

exec vi "$file"
