#!/usr/bin/env bash
# Desktop entry point. Opens the setup wizard until it has been finished,
# then opens the journal. Runs inside the graphical session so the
# on-screen keyboard can follow text fields.

set -euo pipefail
unset CDPATH

ROOT=/opt/secure-journal
if [ ! -d "$ROOT/ui" ]; then
  ROOT=$(cd -- "$(dirname -- "$0")/.." && pwd)
fi
export PYTHONPATH=$ROOT${PYTHONPATH:+:$PYTHONPATH}

STATE=${XDG_CONFIG_HOME:-$HOME/.config}/secure-journal/setup-complete

gtk_ready() {
  python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1
}

if ! gtk_ready && [ -x "$ROOT/scripts/bootstrap.sh" ]; then
  sudo -n "$ROOT/scripts/bootstrap.sh" || true
fi

if [ ! -f "$STATE" ]; then
  if gtk_ready; then
    exec python3 -m ui.setup_wizard
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Journal setup" "The setup components are not installed yet. Connect Ethernet or join Wi-Fi from the network menu, then log out and back in."
  fi
  exit 0
fi

if gtk_ready; then
  exec python3 -m ui.journal_app
fi

exec "$ROOT/scripts/journal"
